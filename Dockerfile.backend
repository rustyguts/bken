# Python CLI image: faster-whisper + PANNs + ffmpeg.
#
# Runs the pipeline stages (ingest, transcribe, detect-events, score, clip,
# rank). Nothing web-facing lives here — the Nuxt image (Dockerfile.nuxt)
# owns the UI + API.
#
# Uses Astral's uv image so we get Python 3.12 and uv in one layer. Torch
# comes from the CUDA-12.4 index per pyproject.toml; it imports fine on a
# GPU-less box, but the transcribe/detect-events stages need GPU to do
# useful work (see docker-compose.gpu.yml).

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# System packages: ffmpeg for audio decode + thumbnail cuts; libsndfile
# for librosa; git + ca-certs for the occasional wheel build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        libsndfile1 \
        git \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VIDPIPE_DATA=/app/data \
    VIDPIPE_MODELS=/app/models

WORKDIR /app

# --- dep-install layer (cached across source edits) -----------------------
# Copy lock + pyproject first so changes to source code don't re-download torch.
COPY pyproject.toml uv.lock ./
# `--no-install-project` skips building our package (done later in editable
# mode so bind-mounts in dev compose work).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

# --- project layer --------------------------------------------------------
COPY src/ ./src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps -e .

# No EXPOSE — this image is used exclusively via `docker compose exec`.
# docker-compose.yml overrides CMD with `sleep infinity` so the container
# stays up and you can shell in to run `uv run vidpipe …` commands.
CMD ["uv", "run", "vidpipe", "--help"]
