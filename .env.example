# Copy to `.env` and edit to suit.
# Paths are resolved relative to the compose file.

# Where your source gameplay recordings live. Mounted read-only at /archive.
#   Example: /mnt/shack/media/gaming/archive
ARCHIVE_DIR=/mnt/shack/media/gaming/archive

# Redis-compatible broker for asynq. Compose `dragonfly` service is reachable
# at `dragonfly:6379` from other services on the default network.
BKEN_REDIS=dragonfly:6379

# Local LLM endpoint (Ollama, OpenAI-compatible). Compose `ollama` service
# auto-pulls the model on first /api/rank call.
BKEN_LLM_BASE_URL=http://ollama:11434
BKEN_LLM_MODEL=qwen2.5:1.5b-instruct

# Whisper ASR HTTP service. Pick based on hardware:
#   tiny / base       — low-end CPU, noisy output
#   small             — decent CPU, usable quality
#   large-v3-turbo    — modern CPU with AVX2/int8, near-large quality, 2x realtime
#   large-v3          — GPU (≥10 GB VRAM) or beefy CPU + patience — best accuracy
# Model is cached under ./data/whisper after first use (~3 GB for large-v3).
ASR_MODEL=large-v3-turbo
BKEN_ASR_BASE_URL=http://whisper:9000
BKEN_ASR_LANGUAGE=en
