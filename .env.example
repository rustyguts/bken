# Copy to `.env` and edit to suit.
# Paths are resolved relative to the compose file.

# Where your source gameplay recordings live. Mounted read-only into the
# backend at /archive. For the current test setup this is:
#   /mnt/shack/media/gaming/archive
ARCHIVE_DIR=/mnt/shack/media/gaming/archive

# Where your Claude Code CLI auth lives. If unset, the backend won't have
# access to `claude` and the `vidpipe rank` stage will skip.
CLAUDE_HOME=/home/rusty/.claude
