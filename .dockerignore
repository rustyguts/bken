# Don't ship host state into the build context.

# Python local env
cli/.venv/
cli/__pycache__/
cli/*.pyc
cli/.pytest_cache/
cli/.ruff_cache/
cli/.mypy_cache/
.venv/
__pycache__/

# App build + modules (installed inside image)
app/node_modules/
app/.nuxt/
app/.output/

# Go build
node_modules/
*.test
bken
cmd/*/bken

# Persistent data (mounted at runtime, not baked)
data/
models/

# Misc
.git/
.gitignore
.env
.env.local
README.md
*.md
.claude/
